{
  "name": "@surveynt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check:property-data-capabilities": "tsx scripts/check-property-data-capabilities.ts",
    "verify:property-data-security": "tsx scripts/verify-property-data-security.ts",
    "verify:property-data-spatial": "tsx scripts/verify-property-data-spatial.ts",
    "prepare:spatial-geojson": "tsx scripts/prepare-spatial-geojson.ts",
    "prepare:spatial-gml": "tsx scripts/prepare-spatial-gml.ts",
    "prepare:ogc-features": "tsx scripts/prepare-ogc-features.ts",
    "prepare:hmlr-manifest": "tsx scripts/prepare-hmlr-manifest.ts",
    "import:property-data": "tsx scripts/import-property-data.ts",
    "activate:property-data": "tsx scripts/activate-property-data.ts",
    "rollback:property-data": "tsx scripts/rollback-property-data.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.44.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
