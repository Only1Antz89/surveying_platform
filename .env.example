# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side canonical link target for transactional emails.
APP_URL=http://localhost:3000

# Clerk (leave blank to use the local demo workspace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated, exact verified emails. A matching Clerk user is granted
# Surveynt platform access independently of any tenant membership.
PLATFORM_SUPER_ADMIN_EMAILS=anthony@cliftonsurveyors.com

# Neon PostgreSQL
# Runtime tenant traffic uses a role without BYPASSRLS.
DATABASE_APP_URL=
# Vercel's Neon integration-managed owner URL (retained for provider tooling).
DATABASE_URL=
# Server-only owner connection for migrations, webhooks and platform operations.
DATABASE_ADMIN_URL=

# Stripe Billing — use a restricted key in deployed environments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_PRICE_ID=
STRIPE_SEAT_PRICE_ID=

# Optional infrastructure. A private Vercel Blob store holds survey photos and
# documents; without it uploads stay disabled and text capture continues.
BLOB_READ_WRITE_TOKEN=
MEDIA_MAX_UPLOAD_MB=25
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUEUE_CONSUMER_SECRET=
CRON_SECRET=

# Transactional email — add after verifying the sender in SMTP2GO
SMTP2GO_API_KEY=
SMTP2GO_SENDER=

# Property intelligence (see docs/property-intelligence/configuration.md).
# Sources also stay disabled until verified and enabled in reference.data_sources.
PROPERTY_INTELLIGENCE_ENABLED=false
# Importer login role holding surveynt_reference_write (operator CLI only).
DATABASE_IMPORTER_URL=
POSTCODES_IO_BASE_URL=https://api.postcodes.io
# Self-hosted or contracted Nominatim; the public server is for low volume only.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
NOMINATIM_MIN_INTERVAL_MS=1100
