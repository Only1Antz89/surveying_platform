# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side canonical link target for transactional emails.
APP_URL=http://localhost:3000

# Clerk (leave blank to use the local demo workspace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Comma-separated, exact verified emails. A matching Clerk user is granted
# Surveynt platform access independently of any tenant membership.
PLATFORM_SUPER_ADMIN_EMAILS=anthony@cliftonsurveyors.com

# Neon PostgreSQL
# Runtime tenant traffic uses a role without BYPASSRLS.
DATABASE_APP_URL=
# Vercel's Neon integration-managed owner URL (retained for provider tooling).
DATABASE_URL=
# Server-only owner connection for migrations, webhooks and platform operations.
DATABASE_ADMIN_URL=

# Stripe Billing. Keep subscription billing and client survey payments separate.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_PRICE_ID=
STRIPE_SEAT_PRICE_ID=
# Restricted key for client deposit/balance Checkout Sessions in the same account.
STRIPE_CLIENT_PAYMENTS_KEY=
# Set only after legal, accounting, VAT, refund and client-money approval.
CLIENT_PAYMENTS_LAUNCH_APPROVED=false

# Optional infrastructure. A private Vercel Blob store holds survey photos and
# documents; without it uploads stay disabled and text capture continues.
BLOB_READ_WRITE_TOKEN=
MEDIA_MAX_UPLOAD_MB=25
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tenant-scoped submitted address-search cache, clamped to 60 seconds–7 days.
ADDRESS_SEARCH_CACHE_TTL_SECONDS=86400
QUEUE_CONSUMER_SECRET=
CRON_SECRET=

# Transactional email — add after verifying the sender in SMTP2GO
SMTP2GO_API_KEY=
SMTP2GO_SENDER=

# Customer quote access links. Generate a long independent random secret.
QUOTE_TOKEN_SECRET=

# Calendar OAuth and encrypted refresh-token storage. The encryption key must be
# a base64-encoded 32-byte value and supports versioned rotation in stored rows.
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Contracted OSRM-compatible routing service. Public demo routers are not suitable
# for production. Attribution is displayed with route estimates.
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_TOKEN=
ROUTING_PROVIDER_ATTRIBUTION=

# Property intelligence (see docs/property-intelligence/configuration.md).
# Sources also stay disabled until verified and enabled in reference.data_sources.
PROPERTY_INTELLIGENCE_ENABLED=false
# Importer login role holding surveynt_reference_write (operator CLI only).
DATABASE_IMPORTER_URL=
POSTCODES_IO_BASE_URL=https://api.postcodes.io
# Self-hosted or contracted Nominatim; the public server is for low volume only.
NOMINATIM_BASE_URL=
NOMINATIM_USER_AGENT=
NOMINATIM_MIN_INTERVAL_MS=1100
PLANNING_DATA_BASE_URL=https://www.planning.data.gov.uk
# EPC (England & Wales). Confirm endpoint and auth on the official guidance page first.
EPC_API_BASE_URL=
# Current service uses bearer authentication; old basic credentials are ignored by canonical enrichment.
EPC_API_TOKEN=
# Basemap for property maps: a contracted or self-hosted MapLibre style. Unset shows "Basemap not configured".
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Fieldwork planner: approved, attributed imagery and true-scale Terrarium DEM.
# Browser-public URLs only; never place provider secrets in NEXT_PUBLIC values.
NEXT_PUBLIC_FIELD_SATELLITE_TILES=
NEXT_PUBLIC_FIELD_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_FIELD_TERRAIN_URL=
NEXT_PUBLIC_FIELD_TERRAIN_ATTRIBUTION=
# Optional bounded WGS84 context manifest: attribution, caveat, featureCollection.
# Supported kinds: tree (Point), park/garden/green_space (Polygon), landmark (Point).
NEXT_PUBLIC_FIELD_CONTEXT_URL=
# Vector building source/layer identifiers for the configured MapLibre style.
NEXT_PUBLIC_FIELD_BUILDING_SOURCE=
NEXT_PUBLIC_FIELD_BUILDING_LAYER=building
# Kill-switch for source-grounded suggestions and their review.
ASSISTANT_ENABLED=false

# Historical inspection weather: approved commercial/self-hosted Open-Meteo-compatible archive.
# No public default; never substitutes a forecast or claims measured site conditions.
INSPECTION_WEATHER_API_URL=
INSPECTION_WEATHER_API_KEY=
INSPECTION_WEATHER_TERMS_APPROVED=false
# Assistant model adapter. "none" until a provider is chosen, registered and evaluated (A6).
AI_PROVIDER=none
# Shared learning (L0-L4). Off by default; see docs/shared-learning/policy.md before changing.
SHARED_LEARNING_ENABLED=false
DATABASE_LEARNING_URL=
LEARNING_LINEAGE_SECRET=

# Increment version when replacing the active calendar encryption key.
CALENDAR_TOKEN_ENCRYPTION_KEY_VERSION=1
# JSON of prior version -> base64 key; retain until all old connections and OAuth states migrate.
CALENDAR_TOKEN_ENCRYPTION_PREVIOUS_KEYS={}

# Approved workspace presentation; independent of feature/billing entitlements.
SURVEYNT_NEW_UI=true
# Exact approved provider hostnames, comma-separated. Empty denies all connections.
SURVEYNT_OUTBOUND_HOSTS=
# Add one server-only credential variable per configured platform connection.
SURVEYNT_CONNECTION_SECRET_AI=
